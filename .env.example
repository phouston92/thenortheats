# Local development only. Export these before starting processes.
DATABASE_URL=postgres://north:north_dev_only@127.0.0.1:5432/north_dev
REDIS_URL=redis://127.0.0.1:6379
NODE_ENV=development
PORT=3001
# Seed requires an explicit local administrator email, never a default password.
SEED_ADMIN_EMAIL=admin@example.test
# Generate a local MFA secret with an authenticator; required for admin sign-in.
ADMIN_MFA_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MAIL_WEBHOOK_URL=
EXPO_PUBLIC_API_URL=http://localhost:3001
