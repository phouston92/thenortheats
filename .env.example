# Local development only. Export these before starting processes.
DATABASE_URL=postgres://north:north_dev_only@127.0.0.1:5432/north_dev
REDIS_URL=redis://127.0.0.1:6379
NODE_ENV=development
PORT=3001
# Seed requires an explicit local administrator email, never a default password.
SEED_ADMIN_EMAIL=admin@example.test
# Generate 32 random bytes as 64 hex characters; keep outside the database/backups.
MFA_ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PARTNER_PORTAL_ORIGIN=http://localhost:5174
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Only explicit trusted reverse-proxy CIDRs, never trust every forwarded IP.
TRUST_PROXY_CIDRS=
MAIL_WEBHOOK_URL=
EXPO_PUBLIC_API_URL=http://localhost:3001

# Optional named MFA keyring transition; never commit real key values.
MFA_ENCRYPTION_KEYS=
MFA_ACTIVE_KEY_ID=
# Read-only account verification and bounded webhook signing-key rotation.
STRIPE_TEST_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET_PREVIOUS=
STRIPE_WEBHOOK_PREVIOUS_EXPIRES_AT=
ADMIN_PORTAL_ORIGIN=http://localhost:5173
NORTH_INSTANCE=development
MONITORING_TOKEN=

# Optional separate platform endpoint secret for application-fee events.
STRIPE_PLATFORM_WEBHOOK_SECRET=
